NODE_ENV=development
PORT=4000
APP_TIMEZONE=America/Guatemala
# Orígenes de navegador permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY=0
REQUEST_BODY_LIMIT=1mb
WEBHOOK_BODY_LIMIT=512kb
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
LOG_LEVEL=info
LOG_FORMAT=pretty
SERVICE_NAME=hotel-hunapu-backend
SLOW_QUERY_THRESHOLD_MS=1000
EVENT_DEPOSIT_PERCENTAGE=30
TRANSPORT_BLOCK_MINUTES=120
CART_EXPIRATION_MINUTES=15
PARK_TICKET_PRICE_ADULT=150
PARK_TICKET_PRICE_CHILD=75
PARK_TICKET_PRICE_FAMILY=400
JWT_SECRET=coloca_aqui_una_clave_segura_de_al_menos_32_caracteres
JWT_EXPIRES_IN=1h

# Google Identity Services: desactivado hasta revisión y pruebas con un cliente web real.
# El mismo Client ID público debe estar en VITE_GOOGLE_CLIENT_ID. No requiere secret.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=

# Base de datos habitual de desarrollo (npm run dev -> hotel_db en puerto 5432)
DATABASE_URL=postgresql://hotel_user:hotel_pass@127.0.0.1:5432/hotel_db
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=hotel_user
DB_PASSWORD=hotel_pass
DB_NAME=hotel_db

# Base de datos de pruebas (npm run dev:test -> hotel_test_db en puerto 55432 o 55433 para tests aislados)
TEST_DATABASE_URL=postgresql://hotel_test_user:hotel_test_password@127.0.0.1:55432/hotel_test_db

# Stripe (modo prueba)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AWS S3 (Almacenamiento privado multimedia)
AWS_REGION=us-east-2
AWS_S3_BUCKET=hotel-hunahpu-media-2026
# Perfil local de AWS CLI/SDK (opcional; en producción o contenedores se usan variables de entorno de IAM o roles de instancia)
AWS_PROFILE=hotel-hunahpu

# AWS CloudFront (CDN para distribución de imágenes públicas)
CLOUDFRONT_BASE_URL=https://dy6alx8uozfo3.cloudfront.net

# Expiración de reservas de habitación pendientes (apagada por defecto).
# No la active hasta aplicar la migración expira_en y regularizar las reservas históricas.
RESERVA_PENDIENTE_EXPIRACION_ACTIVA=false
RESERVA_PENDIENTE_TTL_MINUTOS=30
RESERVA_EXPIRACION_INTERVALO_SEGUNDOS=60
RESERVA_EXPIRACION_GRACIA_PAGO_MINUTOS=30
RESERVA_EXPIRACION_LOTE=50
