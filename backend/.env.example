NODE_ENV=development
PORT=4000
APP_TIMEZONE=America/Guatemala
# Comma-separated browser origins. Empty allows local non-browser clients only.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY=0
REQUEST_BODY_LIMIT=1mb
WEBHOOK_BODY_LIMIT=512kb
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
EVENT_DEPOSIT_PERCENTAGE=30
TRANSPORT_BLOCK_MINUTES=120
CART_EXPIRATION_MINUTES=15
PARK_TICKET_PRICE_ADULT=150
PARK_TICKET_PRICE_CHILD=75
PARK_TICKET_PRICE_FAMILY=400
JWT_SECRET=coloca_aqui_una_clave_segura_y_larga
JWT_EXPIRES_IN=1H
DATABASE_URL=postgresql://hotel_user:change_me@127.0.0.1:5432/hotel_db
# Solo para NODE_ENV=test; apunta al contenedor aislado de pruebas.
TEST_DATABASE_URL=postgresql://hotel_test_user:hotel_test_password@127.0.0.1:55432/hotel_test_db
# Stripe es opcional. Si se configura una variable, deben configurarse ambas.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=