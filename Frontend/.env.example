# URL base de la API backend de HOTEL HUNAHPÚ (desarrollo)
VITE_API_BASE_URL=http://localhost:4000/api

# Activar solo después de revisar GOOGLE-02. Client ID público, nunca Client Secret.
VITE_GOOGLE_LOGIN_ENABLED=false
VITE_GOOGLE_CLIENT_ID=

# Clave pública de Stripe en modo de prueba (pk_test_...)
VITE_STRIPE_PUBLISHABLE_KEY=

# URLs públicas en AWS S3 para logos (dejar vacías hasta que estén publicados en S3)
VITE_BRAND_LOGO_HORIZONTAL_COLOR=
VITE_BRAND_LOGO_HORIZONTAL_BLANCO=
VITE_BRAND_ISOTIPO_COLOR=
